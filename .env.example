# ─── Friendboxd environment variables ───────────────────────────────────
# Copy this file to `.env.local` for local development, or set the same
# variables in your hosting platform (Render → Environment, Vercel, etc.).

# ── AI layer (optional) ─────────────────────────────────────────────────
# Leave unset to run without AI (deterministic reasons are used instead).
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (defaults to OpenAI).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Crawler (optional) ──────────────────────────────────────────────────
# auto   → HTTP first, Playwright browser fallback (default)
# http   → HTTP only
# browser→ Playwright browser only
CRAWLER_MODE=auto
CRAWLER_MAX_PAGES=3
CRAWLER_DELAY_MS=500
CRAWLER_TIMEOUT_MS=20000
CRAWLER_MAX_FILMS=200
CRAWLER_MAX_FRIENDS=20

# ── Cache (optional) ────────────────────────────────────────────────────
# Local default: .cache (gitignored). In containers, set to /tmp or a disk.
CACHE_DIR=.cache
CACHE_TTL_MS=3600000

# ── Proxy pool (optional) ───────────────────────────────────────────────
# Comma-separated proxy URLs. When multiple are set, each retry attempt
# rotates to a different proxy (up to PROXY_MAX_TRIES, default 3).
# Format: http://user:pass@host:port  or  http://host:port
PROXY_POOL=
PROXY_MAX_TRIES=3