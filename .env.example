# ─── Friendboxd environment variables ───────────────────────────────────
# Copy this file to `.env.local` for local development, or set the same
# variables in your hosting platform (Render → Environment, Vercel, etc.).

# ── AI layer (optional) ─────────────────────────────────────────────────
# Leave unset to run without AI (deterministic reasons are used instead).
# API key for the AI layer (optional).
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (defaults to OpenAI).
OPENAI_BASE_URL=https://api.openai.com/v1
# Model used for reasons / "more like this".
OPENAI_MODEL=gpt-4o-mini

# ── Crawler (optional) ──────────────────────────────────────────────────
# Crawl strategy: auto | http | browser.
CRAWLER_MODE=auto
# Max pages crawled per profile.
CRAWLER_MAX_PAGES=3
# Polite delay between requests (ms).
CRAWLER_DELAY_MS=200
# Per-request timeout (ms).
CRAWLER_TIMEOUT_MS=20000
# Max films considered per profile.
CRAWLER_MAX_FILMS=200
# Max friends discovered.
CRAWLER_MAX_FRIENDS=20
# Pages crawled for the user's own watchlist (exclusion set).
CRAWLER_MAX_USER_PAGES=5
# Max requests per sliding window (rate limiter). 8 per 10s default — safe
# with TLS impersonation; lower it (e.g. 2) if you see 403s on one IP.
CRAWLER_RATE_MAX=8
# Rate-limiter window length (ms).
CRAWLER_RATE_WINDOW_MS=10000
# Max time (ms) the browser strategy waits for lazy-loaded posters to appear
# (Letterboxd ships an empty placeholder until JS swaps in the real poster).
# Adaptive — stops as soon as a poster loads; capped so low-RAM hosts like
# Render aren't pinned for too long.
CRAWLER_POSTER_WAIT_MS=4000
# Delay (ms) between scroll steps when triggering lazy loading in the browser.
CRAWLER_BROWSER_SCROLL_DELAY_MS=120

# ── Cache (optional) ────────────────────────────────────────────────────
# Crawl cache directory (gitignored locally).
CACHE_DIR=.cache
# Cache lifetime in ms (1h).
CACHE_TTL_MS=3600000

# ── Proxy pool (optional) ───────────────────────────────────────────────
# Comma-separated proxy URLs (http://user:pass@host:port).
PROXY_POOL=
# Max different proxies tried per request when the pool has multiple.
PROXY_MAX_TRIES=3

# ── Browser fingerprint / TLS impersonation (optional) ──────────────────
# The crawler presents a coherent per-session browser fingerprint: UA,
# Client Hints (sec-ch-ua*) and — when curl-impersonate is installed — a
# real Chrome TLS handshake, all matched to one "impersonation target".
#
# Pin the identity with CRAWLER_IMPERSONATE (must be a known profile:
# chrome131 | chrome124 | chrome120 | chrome116). When unset, a known
# profile is picked at RANDOM per session so consecutive crawls rotate
# identities instead of always using the same one.
CRAWLER_IMPERSONATE=chrome131
#
# TLS impersonation via the curl-impersonate binary: auto | off.
# "auto" uses the binary when it's found on PATH (or CURL_IMPERSONATE_BIN),
# and falls back to plain undici fetch when it isn't. The Docker image
# bundles the binary by default.
CRAWLER_TLS_IMPERSONATION=auto
# Explicit path to a curl-impersonate binary (searched on PATH otherwise).
CURL_IMPERSONATE_BIN=